<?xml version="1.0" encoding="utf-8"?>
<!-- soft_motion: Home fading back in (returning from an app or a settings page), with a hint of settling scale. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:shareInterpolator="true">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="240" />
    <scale android:fromXScale="1.03" android:toXScale="1.0" android:fromYScale="1.03" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" android:duration="240" />
</set>
